# Base URL приложения (для NextAuth, публичных ссылок, платежей)
NEXT_PUBLIC_APP_URL=http://localhost:3003

# PostgreSQL (Docker: postgres://user:password@localhost:5432/involtcad)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/involtcad

# NextAuth (сгенерировать случайную строку: openssl rand -base64 32)
NEXTAUTH_URL=http://localhost:3003
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth (опционально, для входа через Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email/SMTP (опционально, для входа по email)
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=noreply@involtcad.ru

# YooKassa (опционально, для платежей)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_TOKEN=

# Cron (опционально, для защиты автоматических cron-эндпоинтов)
CRON_SECRET=your_cron_secret_here

# Telegram Bot (опционально, для отправки сообщений клиентам/лидам через Telegram)
TELEGRAM_BOT_TOKEN=

# AI-провайдер OpenAI-compatible (опционально, для /api/ai/chat и /api/ai/analyze)
# Бесплатные/дешевые варианты: Groq, OpenRouter (:free модели), Together AI, локальный Ollama
AI_API_URL=https://api.groq.com/openai/v1/chat/completions
AI_API_KEY=
AI_MODEL=llama3-8b-8192
AI_COST_CREDITS=1
AI_ANALYZE_COST=2

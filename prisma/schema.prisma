generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ProjectRole {
  owner
  editor
  viewer
}

// ---------- Auth (NextAuth) ----------

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  role          String   @default("user")
  credits       Int      @default(0)

  accounts           Account[]
  sessions           Session[]
  projects           Project[]
  projectMembers     ProjectMember[]
  templates          ProjectTemplate[] @relation("TemplateCreator")
  subscriptions      UserSubscription[]
  creditTransactions CreditTransaction[]
  payments           Payment[]
  purchases          Purchase[]        @relation("PurchaseBuyer")
  sales              Purchase[]        @relation("PurchaseSeller")
  marketplaceDevices DeviceCatalogItem[] @relation("DeviceSeller")
  marketplaceTemplates ProjectTemplate[] @relation("TemplateSeller")
  reviewsWritten     Review[]          @relation("ReviewBuyer")
  reviewsReceived    Review[]          @relation("ReviewSeller")
  aiChatMessages     AiChatMessage[]
  aiUsageLogs        AiUsageLog[]
  crmClients         CrmClient[]
  crmLeads           CrmLead[]
  crmDeals           CrmDeal[]
  crmTasks           CrmTask[]
  crmCalendarEvents  CrmCalendarEvent[]
  crmActivityLogs    CrmActivityLog[]
  crmEmailLogs       CrmEmailLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Projects ----------

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  userId      String?
  crmClientId String?
  crmDealId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  walls     Wall[]
  openings  Opening[]
  rooms     Room[]
  devices   Device[]
  cables    Cable[]
  dimensions Dimension[]
  members   ProjectMember[]
  consumers Consumer[]
  circuits  Circuit[]
  distributionBoards DistributionBoard[]
  cableRuns CableRun[]
  estimates Estimate[]
  invoices  Invoice[]
  documents Document[]
  automationConfigs AutomationConfig[]
  aiChatMessages    AiChatMessage[]
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  crmClient CrmClient? @relation(fields: [crmClientId], references: [id], onDelete: SetNull)
  crmDeal   CrmDeal?   @relation(fields: [crmDealId], references: [id], onDelete: SetNull)

  @@index([crmClientId])
  @@index([crmDealId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(viewer)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model Wall {
  id        String @id @default(cuid())
  projectId String
  startX    Float
  startY    Float
  endX      Float
  endY      Float
  thickness Float  @default(200)
  arcRadius Float?
  arcClockwise Boolean?

  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  openings  Opening[]
}

model Opening {
  id        String @id @default(cuid())
  projectId String
  wallId    String
  offset    Float
  width     Float
  type      String @default("door")
  height    Float  @default(2000)
  swingSide String @default("left")
  openDir   Int    @default(1)

  wall      Wall   @relation(fields: [wallId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Room {
  id          String @id @default(cuid())
  projectId   String
  name        String
  area        Float?
  perimeter   Float?
  centroidX   Float?
  centroidY   Float?
  type        String @default("other")
  heightMm    Float?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  consumers   Consumer[]
}

model Device {
  id            String @id @default(cuid())
  projectId     String
  deviceType    String
  name          String
  wallId        String?
  wallT         Float?
  wallSide      Int?
  offset        Float  @default(0)
  height        Float?
  rotation      Float  @default(0)
  properties    Json   @default("{}")

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Cable {
  id            String @id @default(cuid())
  projectId     String
  cableType     String @default("power")
  crossSection  Float  @default(2.5)
  length        Float?
  totalLength   Float?
  waypoints     Json   @default("[]")
  sourceDeviceId String?
  targetDeviceId String?

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Dimension {
  id            String @id @default(cuid())
  projectId     String
  startX        Float
  startY        Float
  endX          Float
  endY          Float
  length        Float
  text          String?
  offset        Float  @default(0)

  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ---------- Rooms & Consumers (Electrical calculation) ----------

model Consumer {
  id          String   @id @default(cuid())
  projectId   String
  roomId      String?
  deviceId    String?  // optional link to Device on plan
  name        String
  category    String   // socket | switch | light | appliance | lowcurrent
  type        String   // concrete type from catalog
  powerW      Float    @default(0)
  voltage     Float    @default(230)
  count       Int      @default(1)
  demandRatio Float    @default(1)
  roomName    String?  // cached for free consumers
  circuitId   String?
  phase       String   @default("L1")
  properties  Json     @default("{}")
  sortOrder   Int      @default(0)

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  room        Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  circuit     Circuit? @relation(fields: [circuitId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([roomId])
  @@index([circuitId])
}

model Circuit {
  id              String   @id @default(cuid())
  projectId       String
  boardId         String?
  name            String
  type            String   // socket | lighting | appliance | lowcurrent | heating
  ratedCurrentA   Float?
  breakerType     String?  // B | C | D | dif | dif-selective
  cableType       String?
  crossSectionMm2 Float?
  lengthM         Float?
  consumers       Consumer[]
  phase           String   @default("L1")
  color           String?  // hex color for diagram
  sortOrder       Int      @default(0)

  project         Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  board           DistributionBoard?  @relation(fields: [boardId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([boardId])
}

model DistributionBoard {
  id              String   @id @default(cuid())
  projectId       String
  name            String   @default("Щит")
  inBreakerA      Float?
  inBreakerType   String?
  rcdIn           Boolean  @default(false)
  rcdInMA         Float?
  rcdInType       String?  // AC | A | S
  voltage         Float    @default(230)
  phases          String   @default("single") // single | three
  dinModules      Int      @default(0)
  enclosureType   String   @default("surface") // surface | flush | floor
  manufacturer    String?
  article         String?
  priceLevel      String   @default("standard") // budget | standard | premium
  circuits        Circuit[]
  properties      Json     @default("{}")

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CableRun {
  id              String   @id @default(cuid())
  projectId       String
  circuitId       String?
  fromDeviceId    String?
  toDeviceId      String?
  cableType       String   @default("power")
  crossSectionMm2 Float    @default(2.5)
  routeM          Float    @default(0)
  spareM          Float    @default(0)
  totalM          Float    @default(0)
  segments        Json     @default("[]")
  description     String?

  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([circuitId])
}

// ---------- Price catalogs ----------

model PriceItem {
  id            String   @id @default(cuid())
  userId        String?  // null = built-in
  category      String
  name          String
  unit          String
  priceBudget   Int      @default(0) // stored in smallest currency unit (kopecks)
  priceStandard Int      @default(0)
  pricePremium  Int      @default(0)
  currency      String   @default("RUB")
  vendor        String?
  sku           String?
  article       String?
  description   String?
  isBuiltin     Boolean  @default(false)
  isHiddenByAdmin Boolean @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isBuiltin])
}

model PriceWorkItem {
  id            String   @id @default(cuid())
  userId        String?
  category      String
  name          String
  unit          String
  priceBudget   Int      @default(0)
  priceStandard Int      @default(0)
  pricePremium  Int      @default(0)
  currency      String   @default("RUB")
  description   String?
  isBuiltin     Boolean  @default(false)
  isHiddenByAdmin Boolean @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([isBuiltin])
}

// ---------- Estimates & Documents ----------

model Estimate {
  id            String   @id @default(cuid())
  projectId     String
  name          String   @default("Смета")
  priceLevel    String   @default("standard")
  discountPercent Float  @default(0)
  vatPercent    Float    @default(0)
  totalMaterial Int      @default(0)
  totalWork     Int      @default(0)
  total         Int      @default(0)
  status        String   @default("draft") // draft | sent | accepted | rejected
  publicSlug    String?  @unique
  publicExpiresAt DateTime?
  properties    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items         EstimateItem[]

  @@index([projectId])
  @@index([publicSlug])
}

model EstimateItem {
  id            String   @id @default(cuid())
  estimateId    String
  itemType      String   // material | work
  priceItemId   String?
  name          String
  unit          String
  quantity      Float    @default(0)
  price         Int      @default(0)
  total         Int      @default(0)
  sortOrder     Int      @default(0)

  estimate      Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)

  @@index([estimateId])
}

model Invoice {
  id            String   @id @default(cuid())
  projectId     String
  estimateId    String?
  number        String
  amount        Int      @default(0)
  currency      String   @default("RUB")
  vatPercent    Float    @default(0)
  vatAmount     Int      @default(0)
  status        String   @default("draft") // draft | sent | paid | cancelled
  dueDate       DateTime?
  paidAt        DateTime?
  properties    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([estimateId])
}

model Document {
  id            String   @id @default(cuid())
  projectId     String
  type          String   // contract | act | invoice | estimate | spec
  name          String
  fileUrl       String?
  status        String   @default("draft")
  properties    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([type])
}

// ---------- Automation (Wirenboard / Home Assistant) ----------

model AutomationConfig {
  id            String   @id @default(cuid())
  projectId     String
  platform      String   @default("wirenboard") // wirenboard | homeassistant
  name          String
  script        String   @db.Text
  devices       Json     @default("[]")
  properties    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ---------- Marketplace ----------

model DeviceCatalogItem {
  id                String   @id @default(cuid())
  externalId        String?  @unique
  category          String
  deviceType        String
  name              String
  nameRu            String
  svg               String   @db.Text
  width             Float    @default(50)
  height            Float    @default(50)
  defaultHeight     Float?
  properties        Json     @default("[]")
  isBuiltin         Boolean  @default(false)
  userId            String?
  price             Int?
  currency          String   @default("RUB")
  published         Boolean  @default(false)
  isHiddenByAdmin   Boolean  @default(false)
  salesCount        Int      @default(0)
  sellerId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  seller   User?      @relation("DeviceSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  purchases Purchase[]
  reviews Review[]

  @@index([userId])
  @@index([sellerId])
  @@index([published])
}

model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("other")
  templateType String  @default("project") // project | room | device
  isBuiltin   Boolean  @default(false)
  userId      String?
  thumbnail   String?
  data        Json
  price       Int?
  currency    String   @default("RUB")
  published   Boolean  @default(false)
  isHiddenByAdmin Boolean @default(false)
  salesCount  Int      @default(0)
  sellerId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User?      @relation("TemplateCreator", fields: [userId], references: [id], onDelete: SetNull)
  seller User?      @relation("TemplateSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  purchases Purchase[]
  reviews Review[]

  @@index([userId])
  @@index([sellerId])
  @@index([published])
  @@index([templateType])
}

// ---------- Monetization ----------

model Plan {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  description         String?
  priceMonthly        Int      @default(0)
  priceYearly         Int      @default(0)
  currency            String   @default("RUB")
  maxProjects         Int?
  maxExportsPerMonth  Int?
  creditsIncludedMonthly Int   @default(0)
  features            Json     @default("{}")
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions UserSubscription[]
}

model UserSubscription {
  id                   String   @id @default(cuid())
  userId               String
  planId               String
  status               String   @default("active") // active | cancelled | past_due | expired
  interval             String   @default("month")   // month | year
  currentPeriodStart   DateTime @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  provider             String   @default("manual")  // manual | yookassa | stripe
  providerSubscriptionId String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
}

model Payment {
  id                String   @id @default(cuid())
  userId            String
  crmDealId         String?
  provider          String   @default("manual")
  providerPaymentId String?
  amount            Int
  currency          String   @default("RUB")
  status            String   @default("pending") // pending | succeeded | cancelled | refunded
  purpose           String   // subscription | credits | marketplace | deal
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deal             CrmDeal?          @relation(fields: [crmDealId], references: [id], onDelete: SetNull)
  creditTransactions CreditTransaction[]
  purchases          Purchase[]

  @@index([userId])
  @@index([status])
  @@index([crmDealId])
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int
  type        String   // purchase | subscription_grant | usage | refund | manual
  description String?
  paymentId   String?
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
}

model Purchase {
  id                String   @id @default(cuid())
  buyerId           String
  sellerId          String?
  itemType          String   // device | template
  deviceCatalogItemId String?
  projectTemplateId String?
  pricePaid         Int
  platformFee       Int      @default(0)
  sellerEarnings    Int      @default(0)
  paymentId         String?
  createdAt         DateTime @default(now())

  buyer           User             @relation("PurchaseBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller          User?            @relation("PurchaseSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  deviceCatalogItem DeviceCatalogItem? @relation(fields: [deviceCatalogItemId], references: [id], onDelete: SetNull)
  projectTemplate ProjectTemplate? @relation(fields: [projectTemplateId], references: [id], onDelete: SetNull)
  payment         Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([buyerId])
  @@index([sellerId])
  @@index([itemType])
  @@index([paymentId])
  @@unique([paymentId])
  @@unique([buyerId, deviceCatalogItemId])
  @@unique([buyerId, projectTemplateId])
}

model Review {
  id                String   @id @default(cuid())
  buyerId           String
  sellerId          String?
  itemType          String   // "device" | "template"
  deviceCatalogItemId String?
  projectTemplateId String?
  rating            Int
  comment           String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  buyer           User             @relation("ReviewBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller          User?            @relation("ReviewSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  deviceCatalogItem DeviceCatalogItem? @relation(fields: [deviceCatalogItemId], references: [id], onDelete: SetNull)
  projectTemplate ProjectTemplate? @relation(fields: [projectTemplateId], references: [id], onDelete: SetNull)

  @@unique([buyerId, deviceCatalogItemId])
  @@unique([buyerId, projectTemplateId])
  @@index([deviceCatalogItemId])
  @@index([projectTemplateId])
}

model AiChatMessage {
  id          String   @id @default(cuid())
  userId      String
  projectId   String?
  role        String   // user | assistant | system
  content     String   @db.Text
  actions     Json?    @default("[]")
  costCredits Int    @default(0)
  createdAt   DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

model AiUsageLog {
  id          String   @id @default(cuid())
  userId      String
  type        String   // chat | analyze
  model       String?
  tokensIn    Int?
  tokensOut   Int?
  costCredits Int    @default(0)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// ---------- CRM (Baza CRM integration) ----------

model CrmClient {
  id             String   @id @default(cuid())
  userId         String
  name           String
  company        String?
  email          String?
  phone          String?
  telegramChatId String?
  address        String?
  status         String   @default("active") // active | inactive | prospect
  source         String?
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deals     CrmDeal[]
  projects  Project[]
  emails    CrmEmailLog[]

  @@index([userId])
  @@index([status])
}

model CrmLead {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String?
  phone       String?
  company     String?
  status      String   @default("new") // new | contacted | qualified | lost
  source      String?
  notes       String?  @db.Text
  telegramChatId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs    CrmTelegramLog[]
  emails  CrmEmailLog[]

  @@index([userId])
  @@index([status])
}

model CrmDeal {
  id          String   @id @default(cuid())
  userId      String
  clientId    String?
  title       String
  value       Int      @default(0) // kopecks
  currency    String   @default("RUB")
  stage       String   @default("new") // new | negotiation | proposal | won | lost
  probability Int      @default(0)
  expectedCloseDate DateTime?
  closedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client   CrmClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projects Project[]
  emails   CrmEmailLog[]
  payments Payment[]

  @@index([userId])
  @@index([clientId])
  @@index([stage])
}

model CrmTask {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?  @db.Text
  status      String   @default("todo") // todo | in_progress | done
  priority    String   @default("medium") // low | medium | high
  dueDate     DateTime?
  relatedType String?  // client | lead | deal | event
  relatedId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([dueDate])
}

model CrmCalendarEvent {
  id          String   @id @default(cuid())
  userId      String
  title       String
  start       DateTime
  end         DateTime?
  allDay      Boolean  @default(false)
  type        String   @default("meeting") // meeting | call | reminder
  relatedType String?  // client | lead | deal
  relatedId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([start])
}

model CrmActivityLog {
  id          String   @id @default(cuid())
  userId      String
  action      String   // create_client, update_deal_stage, etc.
  entityType  String?  // client | lead | deal | task | event
  entityId    String?
  details     Json     @default("{}")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model CrmTelegramLog {
  id          String   @id @default(cuid())
  leadId      String?
  chatId      String
  message     String   @db.Text
  status      String   @default("sent") // sent | failed
  errorMessage String? @db.Text
  sentAt      DateTime @default(now())

  lead CrmLead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([sentAt])
}

model CrmEmailLog {
  id           String   @id @default(cuid())
  userId       String?
  dealId       String?
  clientId     String?
  leadId       String?
  to           String
  subject      String
  body         String   @db.Text
  status       String   @default("sent") // sent | failed
  errorMessage String?  @db.Text
  sentAt       DateTime @default(now())

  user   User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  deal   CrmDeal?  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  client CrmClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  lead   CrmLead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dealId])
  @@index([clientId])
  @@index([leadId])
  @@index([sentAt])
}
